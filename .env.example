# Copy to .env and fill in. Never commit .env.

# Nebius (OpenAI-compatible). Confirm which host matches the hackathon keys:
#   https://api.tokenfactory.nebius.com/v1/
#   https://api.studio.nebius.com/v1/
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_MODEL=

# Supabase Postgres (backend only). Supabase dashboard > Connect > JDBC connection string.
SUPABASE_DB_URL=jdbc:postgresql://<host>:5432/postgres
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=
